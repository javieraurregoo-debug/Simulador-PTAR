{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/.venv/**,backend/tests/**,backend/.pytest_cache/**,frontend/node_modules/**,frontend/src/**,**/__pycache__/**,**/*.pyc,docs/**,.git/**}"
    }
  }
}
